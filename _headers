# WEB-8: Cloudflare Pages response headers (same set as vercel.json, SEC-4).
# WEB-9: Cloudflare Web Analytics (cookie-free) is injected automatically by Cloudflare;
# its beacon loads from static.cloudflareinsights.com and reports to cloudflareinsights.com.
/*
  Strict-Transport-Security: max-age=63072000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://vpycxybvsnrkmqvtlpok.supabase.co https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# MA-292: Apple reads this file to open Mathic from https://mathic.app/auth/* links.
# No extension on the file, so declare the type; never cached for long.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: max-age=300

# MA-292: the reset page must never be cached or framed; the token hash is in its URL.
# WEB-9: no analytics on auth pages. Pages joins this CSP to the site-wide one, and
# the browser enforces both, so the analytics beacon is blocked under /auth/.
/auth/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  Content-Security-Policy: script-src 'self'; connect-src 'self' https://vpycxybvsnrkmqvtlpok.supabase.co
